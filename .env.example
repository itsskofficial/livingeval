# livingeval configuration. Copy to `.env` and fill in what you need.
#
# NOTHING here is required to run locally. `python scripts/dev.py up` starts a real
# local Supabase and resolves all of the storage settings by itself. The keys below are
# for things with no local equivalent — a hosted LLM judge, a hosted trace store — and
# every feature that does not need them works without them.

# ---------------------------------------------------------------------------
# Storage. Leave unset for local Supabase; `scripts/dev.py` detects it.
# ---------------------------------------------------------------------------
# Supabase Cloud: Dashboard -> Project Settings -> Database -> Connection string.
# Use the **transaction pooler** (port 6543) for the running service. Migrations need
# the session pooler or the direct URL (port 5432); `livingeval db migrate` refuses the
# transaction pooler and tells you why.
# LIVINGEVAL_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Or let livingeval build that URL for you:
# SUPABASE_PROJECT_REF=abcdefghijklmnop
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_REGION=ap-south-1

# Supabase API, for Storage. Dashboard -> Project Settings -> API.
# The service-role key bypasses RLS: backend only, never in a browser.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Where records, figures and exported datasets go.
#   supabase://bucket/prefix   file://./results   s3://bucket/prefix
# LIVINGEVAL_ARTIFACT_URL=supabase://livingeval-artifacts/livingeval

# ---------------------------------------------------------------------------
# Judges. No local equivalent — an LLM judge needs a hosted model.
# Everything except a real-judge ladder runs without these.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Live trace ingestion. Optional: JSONL and OTel files need no credentials.
# ---------------------------------------------------------------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# The server. Only needed when it listens on something other than localhost —
# the app refuses to bind publicly without a key.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
# LIVINGEVAL_API_KEY=
# LIVINGEVAL_HOST=0.0.0.0
# LIVINGEVAL_PORT=8000
# LIVINGEVAL_CORS_ORIGINS=https://your-frontend.example.com
# LIVINGEVAL_LOG_JSON=1
# LIVINGEVAL_ENV=prod

# ---------------------------------------------------------------------------
# What this instance measures.
# ---------------------------------------------------------------------------
# LIVINGEVAL_SUITE=default
# LIVINGEVAL_JUDGE=oracle          # rule:mod:fn | openai:gpt-4o-mini | anthropic:claude-sonnet-4-5
# LIVINGEVAL_EMBED=               # hashing | hf:<model> | openai:text-embedding-3-small
# LIVINGEVAL_WORKER_INTERVAL_S=900
# LIVINGEVAL_WORKER_MINE=20
# LIVINGEVAL_WORKER_INGEST=       # a trace source to pull each tick
